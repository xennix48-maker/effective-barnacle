VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imt0Ymh0Z2x5YmtyYWhxYXhobXJwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc0NjUzMTYsImV4cCI6MjEwMzA0MTMxNn0.jdcjVuGzvsVul15uXzKIEne_u2RMRh9a_xNi4S4qU38
VITE_BOT_USERNAME=BITCOIN_MINING_OFFICAL

# Supabase Edge Function secrets (set via `supabase secrets set` or the
# Supabase Dashboard → Edge Functions → Secrets tab — these are read by the
# Deno runtime, NOT committed to git).
#
# BOT_TOKEN=                  # @BotFather token for tg-auth (HMAC validation)
# ADMIN_TG_IDS=               # comma-separated Telegram numeric IDs that get is_admin=true
# TG_BOT_TOKEN=                # bot used to post submissions to the admin group
# TG_ADMIN_CHAT_ID=            # numeric chat_id of the admin Telegram group
# PUBLIC_ADMIN_URL=            # https://your-vercel-domain.vercel.app (link in Telegram message)
# SUPABASE_SERVICE_ROLE_KEY=   # auto-injected by Supabase